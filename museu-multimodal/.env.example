# Banco vetorial Qdrant (deixe vazio para usar persistência local em data/qdrant_local)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=museum_images

# Origens liberadas no CORS da API FastAPI (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dispositivo de inferência (cpu ou cuda)
DEVICE=cpu

# URL da API consumida pelo frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

