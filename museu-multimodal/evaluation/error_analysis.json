    {
      "item_id": "MNSEE.003.0034",
      "categoria": "Arco de boca",
      "palavras": 37,
      "texto": "Feito de cedro e fibra de caraguatá, guembe pi. Decorado com ferro queimado. Instrumento de corda única, composto por dois arcos que se cruzam. Instrumento representa um casal apaixonado e os arcos o homem e uma mulher.",
      "rank_R1_clip": 24,
      "rank_R1_siglip": 11
    },
    {
      "item_id": "MNSEE.003.0028",
      "categoria": "Apito",
      "palavras": 55,
      "texto": "Feito a partir da raiz da goiaba do campo. Ele se diferencia por estar sob um \"banco\" (apyká). Junto dele está amarrado outro Minby. É um instrumento religioso e musical. Possui um cordão de algodão. É usado como reza para os xamãs. Também pode ser usado para se comunicar, identificando-se na chegada em outro território.",
      "rank_R1_clip": 9,
      "rank_R1_siglip": 11
    },
    {
      "item_id": "MNSEE.003.0035",
      "categoria": "Saia",
      "palavras": 12,
      "texto": "Algodão com detalhes laranja e amarelo. Utilizado em rituais políticos e religiosos.",
      "rank_R1_clip": 30,
      "rank_R1_siglip": 7
    },
    {
      "item_id": "MNSEE.003.0011",
      "categoria": "Maracá",
      "palavras": 38,
      "texto": "Possui um cordão colorido com fios de lã aglomerados. É atravessado por um pedaço de madeira (cedro). Se usa nos rituais religiosos para se comunicar com as famílias de outros lugares e é também uma forma de proteção.",
      "rank_R1_clip": 6,
      "rank_R1_siglip": 7
    },
    {
      "item_id": "MNSEE.003.0032",
      "categoria": "Cordão",
      "palavras": 13,
      "texto": "Cordão feito com sementes e aglomerados de lã em vermelho, branco e verde.",
      "rank_R1_clip": 21,
      "rank_R1_siglip": 6
    }
  ]
